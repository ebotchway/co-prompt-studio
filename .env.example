NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SECRET_KEY
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.5-flash

GEMINI_RUNS_ENABLED=false

# Security hardening
# Per-IP room creation quota (fixed window)
ROOM_CREATE_WINDOW_SECONDS=3600
ROOM_CREATE_MAX_PER_WINDOW=10
# Per-room edit bursts
ROOM_PATCH_WINDOW_SECONDS=60
ROOM_PATCH_MAX_PER_WINDOW=120
# Paid AI run quotas (shared window across all serverless instances)
RUN_QUOTA_WINDOW_SECONDS=86400
RUN_QUOTA_PER_ROOM_DAY=50
RUN_QUOTA_GLOBAL_DAY=500
# Stale run claims older than this are released automatically
RUN_CLAIM_TTL_SECONDS=90
# Stricter per-field input cap for the shared test input
TEST_INPUT_MAX_CHARS=8000
